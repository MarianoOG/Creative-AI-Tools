# Copy to .env (git-ignored). Each user brings their own keys; never commit them.

# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# LLM provider: anthropic (default) or openai
SCOUT_LLM_PROVIDER=anthropic
# Optional model override (required for openai)
SCOUT_LLM_MODEL=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
